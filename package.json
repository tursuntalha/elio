{
  "name": "elio-terminal",
  "productName": "Elio",
  "description": "Elio — Claude Code, Codex and OpenCode in a customizable terminal workspace.",
  "version": "0.20.0",
  "license": "MIT",
  "author": "Talha Tursun",
  "homepage": "https://github.com/tursuntalha/elio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tursuntalha/elio.git"
  },
  "bugs": {
    "url": "https://github.com/tursuntalha/elio/issues"
  },
  "keywords": [
    "terminal",
    "claude-code",
    "codex",
    "opencode",
    "electron",
    "xterm",
    "tui",
    "cli",
    "ai-agents",
    "windows"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./desktop/main.cjs",
  "bin": {
    "elio": "./bin/elio.cjs"
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "start": "node bin/elio.cjs",
    "start:window": "node bin/elio.cjs --window",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/desktop-smoke.cjs",
    "test:desktop": "node test/desktop-smoke.cjs",
    "test:terminal": "node test/tui-live.cjs",
    "test:vscode": "node test/vscode-function-keys.cjs",
    "palettes:import": "node scripts/import-palettes.cjs",
    "fonts:bundle": "node scripts/bundle-fonts.cjs",
    "prepack": "node scripts/bundle-fonts.cjs",
    "package": "npm pack",
    "package:portable": "node scripts/build-portable.cjs",
    "shortcut": "node scripts/install-shortcut.cjs",
    "icons:generate": "node scripts/generate-icon.cjs",
    "test:projects": "node test/desktop-projects.cjs",
    "brand:build": "node scripts/build-elio-brand.cjs",
    "launcher:build": "node scripts/build-launcher.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@fontsource/anonymous-pro": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@fontsource/cascadia-code": "5.3.0",
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@fontsource/cutive-mono": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/overpass-mono": "5.3.0",
    "@fontsource/oxygen-mono": "5.3.0",
    "@fontsource/pt-mono": "5.3.0",
    "@fontsource/red-hat-mono": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/sometype-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.1",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "@fontsource/victor-mono": "5.3.0",
    "playwright-core": "^1.64.1"
  }
}
